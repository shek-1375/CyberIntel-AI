# Copy this file to .env and add your key.
# Use an "AIza..." key (Google Cloud Console > APIs & Services > Credentials > Create credentials > API key)
GOOGLE_API_KEY=your_gemini_api_key

# Models
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_RERANK_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite   # tried in order if a model is busy (503)
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Qdrant
QDRANT_URL=http://localhost:6333

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval (Day 2)
TOP_K=4              # chunks given to Gemini for the answer
SEARCH_MODE=hybrid   # dense | keyword | hybrid | auto (hybrid only for questions with a CVE/ATT&CK ID)
CANDIDATES=10        # chunks each retriever fetches before fusion / reranking
RRF_K=60             # Reciprocal Rank Fusion constant
DENSE_WEIGHT=1.0     # RRF weight for dense results (2.0 = trust dense twice as much)
KEYWORD_WEIGHT=1.0   # RRF weight for keyword results
RERANK=true          # re-order candidates before answering
RERANKER=cross-encoder   # cross-encoder (runs locally, free, no API) | gemini
CROSS_ENCODER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
